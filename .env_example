# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (required in production)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_NAME=database.db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256

# ── App ───────────────────────────────────────────────────────────────────────
BANK_NAME=Robux
CEILING_ACCOUNT=50000
# Set to "true" in production to enable Secure cookie flag and HSTS
IS_PROD=false

# ── Email ─────────────────────────────────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=465
MAIL_SERVER=
MAIL_FROM_NAME=Robux Republic
MAIL_STARTTLS=False
MAIL_SSL_TLS=True
USE_CREDENTIALS=True
VALIDATE_CERTS=True
